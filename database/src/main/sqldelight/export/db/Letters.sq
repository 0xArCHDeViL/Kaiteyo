CREATE TABLE character_stroke(
    character       TEXT NOT NULL,
    stroke_number   INTEGER  NOT NULL,
    stroke_path     TEXT NOT NULL,
    PRIMARY KEY (character, stroke_number)
);

CREATE TABLE radical(
    radical      TEXT NOT NULL,
    strokesCount INTEGER  NOT NULL,
    PRIMARY KEY (radical, strokesCount)
);

CREATE TABLE kanji_data(
    kanji TEXT NOT NULL PRIMARY KEY,
    frequency  INTEGER,
    variantFamily TEXT
);

CREATE TABLE kanji_reading(
    kanji        TEXT NOT NULL,
    reading_type TEXT NOT NULL,
    reading      TEXT NOT NULL,
    PRIMARY KEY (kanji, reading_type, reading)
);

CREATE TABLE kanji_meaning(
    kanji    TEXT NOT NULL,
    meaning  TEXT NOT NULL,
    priority INTEGER NOT NULL,
    PRIMARY KEY (kanji, meaning, priority)
);

CREATE TABLE kanji_radical(
    kanji         TEXT NOT NULL,
    radical       TEXT NOT NULL,
    start_stroke  INTEGER NOT NULL,
    strokes_count INTEGER NOT NULL,
    PRIMARY KEY (kanji, radical, start_stroke)
);

CREATE TABLE kanji_classification(
    kanji    TEXT NOT NULL,
    class    TEXT NOT NULL,
    PRIMARY KEY (kanji, class)
);

CREATE TABLE letter_vocab_example(
    letter      TEXT NOT NULL,
    vocab_id    INTEGER NOT NULL,
    kanji       TEXT,
    kana        TEXT NOT NULL,
    PRIMARY KEY (letter, vocab_id, kanji, kana)
);

CREATE INDEX idx_kanji_classification_class_kanji
ON kanji_classification(class, kanji);

CREATE INDEX idx_kanji_radical_radical_kanji
ON kanji_radical(radical, kanji, start_stroke);

CREATE TABLE learning_node(
    node_id INTEGER PRIMARY KEY AUTOINCREMENT,
    node_key TEXT NOT NULL UNIQUE,
    node_kind TEXT NOT NULL,
    kanji TEXT,
    reading TEXT,
    entry_id INTEGER,
    element_id INTEGER,
    sense_id INTEGER,
    sentence_id INTEGER,
    level INTEGER,
    priority REAL NOT NULL DEFAULT 0
);

CREATE TABLE learning_edge(
    from_node_id INTEGER NOT NULL,
    to_node_id INTEGER NOT NULL,
    edge_kind TEXT NOT NULL,
    weight REAL NOT NULL DEFAULT 0,
    provenance TEXT NOT NULL,
    PRIMARY KEY(from_node_id, to_node_id, edge_kind)
);

CREATE INDEX idx_learning_node_kind_level
ON learning_node(node_kind, level, priority DESC, node_id);

CREATE INDEX idx_learning_edge_from_kind_weight
ON learning_edge(from_node_id, edge_kind, weight DESC, to_node_id);

CREATE INDEX idx_learning_edge_to_kind
ON learning_edge(to_node_id, edge_kind, from_node_id);

insertLearningNode:
INSERT INTO learning_node(
    node_id, node_key, node_kind, kanji, reading, entry_id, element_id,
    sense_id, sentence_id, level, priority
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertLearningEdge:
INSERT OR IGNORE INTO learning_edge(
    from_node_id, to_node_id, edge_kind, weight, provenance
)
VALUES (?, ?, ?, ?, ?);

insertCharacterStroke:
INSERT INTO character_stroke VALUES ?;
insertRadical:
INSERT INTO radical VALUES ?;
insertKanjiData:
INSERT INTO kanji_data VALUES ?;
insertKanjiReading:
INSERT INTO kanji_reading VALUES ?;
insertKanjiMeaning:
INSERT INTO kanji_meaning VALUES ?;
insertKanjiRadical:
INSERT INTO kanji_radical VALUES ?;
insertKanjiClassification:
INSERT INTO kanji_classification VALUES ?;
insertLetterVocabExample:
INSERT INTO letter_vocab_example VALUES ?;
