CREATE TABLE character_stroke(
    character       TEXT NOT NULL,
    stroke_number   INTEGER  NOT NULL,
    stroke_path     TEXT NOT NULL,
    PRIMARY KEY (character, stroke_number)
);

CREATE TABLE radical(
    radical      TEXT NOT NULL,
    strokesCount INTEGER  NOT NULL,
    PRIMARY KEY (radical, strokesCount)
);

CREATE TABLE kanji_data(
    kanji TEXT NOT NULL PRIMARY KEY,
    frequency  INTEGER,
    variantFamily TEXT
);

CREATE TABLE kanji_reading(
    kanji        TEXT NOT NULL,
    reading_type TEXT NOT NULL,
    reading      TEXT NOT NULL,
    PRIMARY KEY (kanji, reading_type, reading)
);

CREATE TABLE kanji_meaning(
    kanji    TEXT NOT NULL,
    meaning  TEXT NOT NULL,
    priority INTEGER NOT NULL,
    PRIMARY KEY (kanji, meaning, priority)
);

CREATE TABLE kanji_classification(
    kanji    TEXT NOT NULL,
    class    TEXT NOT NULL,
    PRIMARY KEY (kanji, class)
);

CREATE TABLE letter_vocab_example(
    letter      TEXT NOT NULL,
    vocab_id    INTEGER NOT NULL,
    kanji       TEXT,
    kana        TEXT NOT NULL,
    PRIMARY KEY (letter, vocab_id, kanji, kana)
);

getVocabExamplesForLetter:
SELECT *
FROM letter_vocab_example
WHERE letter = ?
ORDER BY rowid;

getClassificationsForKanji:
SELECT class
FROM kanji_classification
WHERE kanji = ?;

getKanjiWithClassification:
SELECT kanji
FROM kanji_classification
WHERE class = ?;

CREATE TABLE kanji_radical(
    kanji         TEXT NOT NULL,
    radical       TEXT NOT NULL,
    start_stroke  INTEGER NOT NULL,
    strokes_count INTEGER NOT NULL,
    PRIMARY KEY (kanji, radical, start_stroke)
);

getStrokes:
SELECT stroke_path FROM character_stroke WHERE character = ? ORDER BY stroke_number;

getCharacterRadicals:
SELECT kanji_radical.*
FROM kanji_radical
WHERE kanji = ?
ORDER BY start_stroke;

getCharacterRadicalsForCharacters:
SELECT kanji_radical.*
FROM kanji_radical
WHERE kanji IN :characters
ORDER BY kanji, start_stroke;

getKanjiMeanings:
SELECT meaning FROM kanji_meaning WHERE kanji = ? ORDER BY priority;

getKanjiReadings:
SELECT * FROM kanji_reading WHERE kanji = ?;

getKanjiData:
SELECT * FROM kanji_data WHERE kanji = ?;

getRadicals:
SELECT * FROM radical;

getCharsWithRadicals:
SELECT kanji
FROM kanji_radical
WHERE radical IN :radicals
GROUP BY kanji
HAVING COUNT(DISTINCT radical) = :radicalsCount
ORDER BY kanji;

getAllRadicalsInCharactersWithSelectedRadicals:
WITH characters_with_selected_radicals AS (
    SELECT kanji
    FROM kanji_radical
    WHERE radical IN :radicals
    GROUP BY kanji
    HAVING COUNT(DISTINCT radical) = :radicalsCount
)
SELECT DISTINCT radical
FROM kanji_radical
WHERE kanji IN characters_with_selected_radicals
ORDER BY radical;

-- ============================================
-- Kanji Browser queries
-- ============================================

getAllKanji:
SELECT kanji, frequency
FROM kanji_data
ORDER BY COALESCE(frequency, 2147483647), kanji;

getAllKanjiMeanings:
SELECT kanji, meaning
FROM kanji_meaning
ORDER BY kanji, priority;

getAllKanjiReadings:
SELECT kanji, reading_type, reading
FROM kanji_reading
ORDER BY kanji;

getAllClassifications:
SELECT kanji, class
FROM kanji_classification;

getKanjiStrokeCounts:
SELECT character, COUNT(*) AS stroke_count
FROM character_stroke
GROUP BY character;

getKanjiCatalog:
WITH meanings AS (
    SELECT kanji, group_concat(meaning, :delimiter) AS meanings
    FROM (
        SELECT kanji, meaning
        FROM kanji_meaning
        ORDER BY kanji, priority
    )
    GROUP BY kanji
), on_readings AS (
    SELECT kanji, group_concat(reading, :delimiter) AS on_readings
    FROM (
        SELECT kanji, reading
        FROM kanji_reading
        WHERE reading_type = 'on'
        ORDER BY kanji, reading
    )
    GROUP BY kanji
), all_readings AS (
    SELECT kanji, group_concat(reading, :delimiter) AS all_readings
    FROM (
        SELECT kanji, reading
        FROM kanji_reading
        ORDER BY kanji, reading_type, reading
    )
    GROUP BY kanji
), classifications AS (
    SELECT kanji, group_concat(class, :delimiter) AS classifications
    FROM (
        SELECT kanji, class
        FROM kanji_classification
        ORDER BY kanji, class
    )
    GROUP BY kanji
), stroke_counts AS (
    SELECT character, COUNT(*) AS stroke_count
    FROM character_stroke
    GROUP BY character
)
SELECT kanji_data.kanji,
       kanji_data.frequency,
       COALESCE(meanings.meanings, '') AS meanings,
       COALESCE(on_readings.on_readings, '') AS on_readings,
       COALESCE(all_readings.all_readings, '') AS all_readings,
       COALESCE(classifications.classifications, '') AS classifications,
       COALESCE(stroke_counts.stroke_count, 0) AS stroke_count
FROM kanji_data
LEFT JOIN meanings ON meanings.kanji = kanji_data.kanji
LEFT JOIN on_readings ON on_readings.kanji = kanji_data.kanji
LEFT JOIN all_readings ON all_readings.kanji = kanji_data.kanji
LEFT JOIN classifications ON classifications.kanji = kanji_data.kanji
LEFT JOIN stroke_counts ON stroke_counts.character = kanji_data.kanji
ORDER BY COALESCE(kanji_data.frequency, 2147483647), kanji_data.kanji;

-- Reverse lookup indexes used by classification and radical filters.
CREATE INDEX idx_kanji_classification_class_kanji
ON kanji_classification(class, kanji);

CREATE INDEX idx_kanji_radical_radical_kanji
ON kanji_radical(radical, kanji, start_stroke);

-- Connected Learning graph read model.
CREATE TABLE learning_node(
    node_id INTEGER PRIMARY KEY AUTOINCREMENT,
    node_key TEXT NOT NULL UNIQUE,
    node_kind TEXT NOT NULL,
    kanji TEXT,
    reading TEXT,
    entry_id INTEGER,
    element_id INTEGER,
    sense_id INTEGER,
    sentence_id INTEGER,
    level INTEGER,
    priority REAL NOT NULL DEFAULT 0
);

CREATE TABLE learning_edge(
    from_node_id INTEGER NOT NULL,
    to_node_id INTEGER NOT NULL,
    edge_kind TEXT NOT NULL,
    weight REAL NOT NULL DEFAULT 0,
    provenance TEXT NOT NULL,
    PRIMARY KEY(from_node_id, to_node_id, edge_kind)
);

CREATE INDEX idx_learning_node_kind_level
ON learning_node(node_kind, level, priority DESC, node_id);

CREATE INDEX idx_learning_edge_from_kind_weight
ON learning_edge(from_node_id, edge_kind, weight DESC, to_node_id);

CREATE INDEX idx_learning_edge_to_kind
ON learning_edge(to_node_id, edge_kind, from_node_id);

getLearningNodeByKey:
SELECT * FROM learning_node WHERE node_key = ?;

getLearningNeighbors:
SELECT target.*, edge.edge_kind, edge.weight, edge.provenance
FROM learning_edge AS edge
JOIN learning_node AS target ON target.node_id = edge.to_node_id
WHERE edge.from_node_id = :nodeId
  AND edge.edge_kind IN :edgeKinds
ORDER BY edge.weight DESC, target.node_key
LIMIT :limit;

getLearningNeighborhood:
WITH RECURSIVE walk(node_id, depth, path) AS (
    SELECT node_id, 0, '/' || CAST(node_id AS TEXT) || '/'
    FROM learning_node
    WHERE node_key = :rootNodeKey

    UNION ALL

    SELECT edge.to_node_id,
           walk.depth + 1,
           walk.path || CAST(edge.to_node_id AS TEXT) || '/'
    FROM walk
    JOIN learning_edge AS edge ON edge.from_node_id = walk.node_id
    WHERE walk.depth < :maxDepth
      AND edge.edge_kind IN :edgeKinds
      AND instr(
          walk.path,
          '/' || CAST(edge.to_node_id AS TEXT) || '/'
      ) = 0
)
SELECT node.*, walk.depth
FROM walk
JOIN learning_node AS node ON node.node_id = walk.node_id
ORDER BY walk.depth, node.priority DESC, node.node_key
LIMIT :limit;
