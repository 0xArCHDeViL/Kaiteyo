CREATE TABLE vocab_entry (
    id INTEGER UNIQUE PRIMARY KEY
);

CREATE TABLE vocab_kanji_element (
    element_id INTEGER PRIMARY KEY AUTOINCREMENT,
    entry_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    priority INTEGER,
    FOREIGN KEY (entry_id) REFERENCES vocab_entry(id) ON DELETE CASCADE
);

CREATE TABLE vocab_kanji_information (
    element_id INTEGER NOT NULL,
    information TEXT NOT NULL,
    PRIMARY KEY(element_id, information),
    FOREIGN KEY (element_id) REFERENCES vocab_kanji_element(element_id) ON DELETE CASCADE
);

CREATE TABLE vocab_kanji_priority (
    element_id INTEGER NOT NULL,
    priority TEXT NOT NULL,
    PRIMARY KEY(element_id, priority),
    FOREIGN KEY (element_id) REFERENCES vocab_kanji_element(element_id) ON DELETE CASCADE
);

CREATE TABLE vocab_kana_element (
    element_id INTEGER PRIMARY KEY AUTOINCREMENT,
    entry_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    no_kanji INTEGER NOT NULL,
    priority INTEGER,
    FOREIGN KEY (entry_id) REFERENCES vocab_entry(id) ON DELETE CASCADE
);

CREATE TABLE vocab_kana_restriction (
    element_id INTEGER NOT NULL,
    restricted_kanji TEXT NOT NULL,
    PRIMARY KEY(element_id, restricted_kanji),
    FOREIGN KEY (element_id) REFERENCES vocab_kana_element(element_id) ON DELETE CASCADE
);

CREATE TABLE vocab_kana_information (
    element_id INTEGER NOT NULL,
    information TEXT NOT NULL,
    PRIMARY KEY(element_id, information),
    FOREIGN KEY (element_id) REFERENCES vocab_kana_element(element_id) ON DELETE CASCADE
);

CREATE TABLE vocab_kana_priority (
    element_id INTEGER NOT NULL,
    priority TEXT NOT NULL,
    PRIMARY KEY(element_id, priority),
    FOREIGN KEY (element_id) REFERENCES vocab_kana_element(element_id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    entry_id INTEGER NOT NULL,
    FOREIGN KEY (entry_id) REFERENCES vocab_entry(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_kanji_restriction (
    sense_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    PRIMARY KEY(sense_id, reading),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_kana_restriction (
    sense_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    PRIMARY KEY(sense_id, reading),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_part_of_speech (
    sense_id INTEGER NOT NULL,
    part_of_speech TEXT NOT NULL,
    PRIMARY KEY(sense_id, part_of_speech),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_cross_reference (
    sense_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    PRIMARY KEY(sense_id, reading),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_antonym (
    sense_id INTEGER NOT NULL,
    antonym TEXT NOT NULL,
    PRIMARY KEY(sense_id, antonym),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_field (
    sense_id INTEGER NOT NULL,
    field_name TEXT NOT NULL,
    PRIMARY KEY(sense_id, field_name),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_miscellaneous (
    sense_id INTEGER NOT NULL,
    miscellaneous_info TEXT NOT NULL,
    PRIMARY KEY(sense_id, miscellaneous_info),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_dialect (
    sense_id INTEGER NOT NULL,
    dialect TEXT NOT NULL,
    PRIMARY KEY(sense_id, dialect),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_gloss (
    sense_id INTEGER NOT NULL,
    gloss_text TEXT NOT NULL,
    language TEXT DEFAULT 'eng',
    type TEXT DEFAULT NULL,
    PRIMARY KEY(sense_id, gloss_text),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_information (
    sense_id INTEGER NOT NULL,
    information TEXT NOT NULL,
    PRIMARY KEY(sense_id, information),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE vocab_sense_example(
    sense_id INTEGER NOT NULL,
    reading TEXT NOT NULL,
    tatoeba_id INTEGER NOT NULL,
    PRIMARY KEY(sense_id, reading, tatoeba_id),
    FOREIGN KEY (sense_id) REFERENCES vocab_sense(id) ON DELETE CASCADE
);

CREATE TABLE sentence(
    tatoeba_id INTEGER PRIMARY KEY NOT NULL,
    sentence TEXT NOT NULL,
    translation TEXT NOT NULL,
    score REAL NOT NULL,
    furigana TEXT NOT NULL
);

CREATE TABLE vocab_entity(
    name TEXT NOT NULL,
    explanation TEXT NOT NULL,
    PRIMARY KEY(name, explanation)
);

CREATE TABLE vocab_furigana(
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    furigana TEXT NOT NULL,
    PRIMARY KEY(text, reading)
);

CREATE TABLE vocab_deck_card(
    jmdict_seq INTEGER NOT NULL,
    kanji TEXT,
    kana TEXT NOT NULL,
    definition TEXT,
    priority INTEGER,
    deck TEXT NOT NULL,
    PRIMARY KEY (jmdict_seq, kanji, kana, deck)
);

-- Portable offline search index. Android's bundled SQLite does not guarantee FTS5,
-- so export precomputes normalized values and keeps the runtime path B-tree based.
CREATE TABLE vocab_search_index (
    entry_id INTEGER NOT NULL,
    field TEXT NOT NULL,
    value TEXT NOT NULL,
    normalized TEXT NOT NULL,
    PRIMARY KEY(entry_id, field, value, normalized),
    FOREIGN KEY (entry_id) REFERENCES vocab_entry(id) ON DELETE CASCADE
);

CREATE TABLE vocab_search_tag (
    entry_id INTEGER NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY(entry_id, tag),
    FOREIGN KEY (entry_id) REFERENCES vocab_entry(id) ON DELETE CASCADE
);

CREATE TABLE vocab_name (
    id INTEGER PRIMARY KEY,
    kanji TEXT,
    kana TEXT NOT NULL,
    romaji TEXT NOT NULL,
    name_type TEXT,
    meaning TEXT NOT NULL
);

-- Foreign-key and search access paths for bounded reads and batched detail loading.
CREATE INDEX idx_vocab_kanji_entry_priority
ON vocab_kanji_element(entry_id, priority, element_id);

CREATE INDEX idx_vocab_kanji_reading_entry
ON vocab_kanji_element(reading, entry_id, element_id);

CREATE INDEX idx_vocab_kana_entry_priority
ON vocab_kana_element(entry_id, priority, element_id);

CREATE INDEX idx_vocab_kana_reading_entry
ON vocab_kana_element(reading, entry_id, element_id);

CREATE INDEX idx_vocab_sense_entry_id
ON vocab_sense(entry_id, id);

CREATE INDEX idx_vocab_sentence_score_id
ON sentence(score, tatoeba_id);

CREATE INDEX idx_vocab_deck_deck_priority
ON vocab_deck_card(deck, priority, jmdict_seq);

CREATE INDEX idx_vocab_search_normalized_field_entry
ON vocab_search_index(normalized, field, entry_id);

CREATE INDEX idx_vocab_search_field_normalized_entry
ON vocab_search_index(field, normalized, entry_id);

CREATE INDEX idx_vocab_search_entry_field
ON vocab_search_index(entry_id, field, normalized);

CREATE INDEX idx_vocab_search_tag_tag_entry
ON vocab_search_tag(tag, entry_id);


insert_vocab_name:
INSERT OR REPLACE INTO vocab_name VALUES ?;

searchVocabNameIds:
SELECT id
FROM vocab_name
WHERE COALESCE(kanji, '') COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR kana COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR romaji COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR meaning COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR COALESCE(name_type, '') COLLATE NOCASE LIKE :pattern ESCAPE '\'
ORDER BY id;

getAllVocabNameIds:
SELECT id
FROM vocab_name
ORDER BY id;

getAllVocabNameIdsPage:
SELECT id
FROM vocab_name
ORDER BY id
LIMIT :limit OFFSET :offset;

getAllVocabNameCount:
SELECT COUNT(*)
FROM vocab_name;

searchVocabNameCount:
SELECT COUNT(*)
FROM vocab_name
WHERE COALESCE(kanji, '') COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR kana COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR romaji COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR meaning COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR COALESCE(name_type, '') COLLATE NOCASE LIKE :pattern ESCAPE '\';

searchVocabNameIdsPage:
SELECT id
FROM vocab_name
WHERE COALESCE(kanji, '') COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR kana COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR romaji COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR meaning COLLATE NOCASE LIKE :pattern ESCAPE '\'
   OR COALESCE(name_type, '') COLLATE NOCASE LIKE :pattern ESCAPE '\'
ORDER BY id
LIMIT :limit OFFSET :offset;

getVocabNamesByIds:
SELECT id, kanji, kana, romaji, name_type, meaning
FROM vocab_name
WHERE id IN :ids
ORDER BY id;

insert_vocab_search_index:
INSERT OR IGNORE INTO vocab_search_index(entry_id, field, value, normalized)
VALUES (?, ?, ?, ?);

insert_vocab_search_tag:
INSERT OR IGNORE INTO vocab_search_tag(entry_id, tag)
VALUES (?, ?);

searchVocabEntryIds:
SELECT DISTINCT entry_id
FROM vocab_search_index
WHERE field IN :fields
  AND normalized GLOB :pattern
ORDER BY entry_id;

searchVocabElementsByReading:
SELECT entry_id, element_id, reading, priority, 0 AS isKana
FROM vocab_kanji_element
WHERE reading GLOB :pattern
UNION ALL
SELECT entry_id, element_id, reading, priority, 1 AS isKana
FROM vocab_kana_element
WHERE reading GLOB :pattern;

getAllVocabEntryIds:
SELECT id
FROM vocab_entry
ORDER BY id;

getVocabSearchEntries:
WITH matched AS (
    SELECT entry_id, element_id, reading, priority, 0 AS isKana
    FROM vocab_kanji_element
    WHERE entry_id IN :entryIds
    UNION ALL
    SELECT entry_id, element_id, reading, priority, 1 AS isKana
    FROM vocab_kana_element
    WHERE entry_id IN :entryIds
), ranked AS (
    SELECT candidate.entry_id,
           candidate.element_id,
           candidate.reading,
           candidate.isKana,
           candidate.priority
    FROM matched AS candidate
    WHERE NOT EXISTS (
        SELECT 1
        FROM matched AS better
        WHERE better.entry_id = candidate.entry_id
          AND (
              (better.priority IS NOT NULL AND candidate.priority IS NULL)
              OR (
                  better.priority IS NOT NULL
                  AND candidate.priority IS NOT NULL
                  AND better.priority < candidate.priority
              )
              OR (
                  (
                      better.priority = candidate.priority
                      OR (better.priority IS NULL AND candidate.priority IS NULL)
                  )
                  AND better.element_id < candidate.element_id
              )
          )
    )
)
SELECT entry_id,
       element_id,
       reading,
       isKana,
       priority
FROM ranked
ORDER BY priority IS NULL, priority, element_id, entry_id
LIMIT :limit OFFSET :offset;

getVocabEntryIdsWithTag:
SELECT entry_id
FROM vocab_search_tag
WHERE tag = :tag;

getVocabDeckCardsCount:
SELECT COUNT(*)
FROM vocab_deck_card
WHERE deck = ?;

getVocabDeckCards:
SELECT *
FROM vocab_deck_card
WHERE deck = ?;

getVocabKanaReadingsOfLength:
SELECT reading
FROM vocab_kana_element
WHERE LENGTH(reading) = :length
GROUP BY reading
ORDER BY ((MIN(element_id) * 1103515245 + :seed) & 2147483647)
LIMIT :limit;

getVocabKanjiElementsWithDetails:
SELECT elements.element_id,
       elements.reading,
       COALESCE((SELECT group_concat(information, :delimiter)
        FROM vocab_kanji_information
        WHERE element_id = elements.element_id), '') AS informations,
       COALESCE((SELECT group_concat(priority, :delimiter)
        FROM vocab_kanji_priority
        WHERE element_id = elements.element_id), '') AS priorities
FROM vocab_kanji_element AS elements
WHERE elements.entry_id = :wordId
ORDER BY elements.element_id;

getVocabKanaElementsWithDetails:
SELECT elements.element_id,
       elements.reading,
       COALESCE((SELECT group_concat(information, :delimiter)
        FROM vocab_kana_information
        WHERE element_id = elements.element_id), '') AS informations,
       COALESCE((SELECT group_concat(priority, :delimiter)
        FROM vocab_kana_priority
        WHERE element_id = elements.element_id), '') AS priorities,
       elements.no_kanji,
       COALESCE((SELECT group_concat(restricted_kanji, :delimiter)
        FROM vocab_kana_restriction
        WHERE element_id = elements.element_id), '') AS restricted_kanji
FROM vocab_kana_element AS elements
WHERE elements.entry_id = :wordId
ORDER BY elements.element_id;

searchFurigana:
SELECT furigana
FROM vocab_furigana
WHERE text = ? AND reading = ?;

getCountOfVocabReadingsWithText:
SELECT COUNT(DISTINCT entry_id)
FROM (
    SELECT entry_id
    FROM vocab_kanji_element
    WHERE reading LIKE '%' || :text || '%'
      AND :includeKanjiReadings
    UNION ALL
    SELECT entry_id
    FROM vocab_kana_element
    WHERE reading LIKE '%' || :text || '%'
);

getVocabReadingsWithText:
WITH matched AS (
    SELECT entry_id, element_id, reading, priority, 0 AS isKana
    FROM vocab_kanji_element
    WHERE reading LIKE '%' || :text || '%'
      AND :includeKanjiReadings
    UNION ALL
    SELECT entry_id, element_id, reading, priority, 1 AS isKana
    FROM vocab_kana_element
    WHERE reading LIKE '%' || :text || '%'
), grouped AS (
    SELECT entry_id, element_id, reading, priority, isKana
    FROM matched
    GROUP BY entry_id
)
SELECT entry_id, element_id, reading, priority, isKana
FROM grouped
ORDER BY priority IS NULL, priority, element_id, entry_id
LIMIT :limit OFFSET :offset;

findVocabElementsByIdOrReading:
WITH matched AS (
    SELECT entry_id, element_id, reading, 0 AS isKana
    FROM vocab_kanji_element
    WHERE entry_id = :entryId
       OR reading = :kanjiReading
    UNION ALL
    SELECT entry_id, element_id, reading, 1 AS isKana
    FROM vocab_kana_element
    WHERE entry_id = :entryId
       OR reading = :kanaReading
)
SELECT entry_id, element_id, reading, isKana
FROM matched
GROUP BY entry_id;

getVocabKanjiElementsForEntries:
SELECT elements.entry_id,
       elements.element_id,
       elements.reading,
       elements.priority,
       COALESCE((SELECT group_concat(information, :delimiter)
        FROM vocab_kanji_information
        WHERE element_id = elements.element_id), '') AS informations
FROM vocab_kanji_element AS elements
WHERE elements.entry_id IN :entryIds
ORDER BY elements.entry_id, elements.priority IS NULL, elements.priority, elements.element_id;

getVocabKanaElementsForEntries:
SELECT elements.entry_id,
       elements.element_id,
       elements.reading,
       elements.priority,
       COALESCE((SELECT group_concat(information, :delimiter)
        FROM vocab_kana_information
        WHERE element_id = elements.element_id), '') AS informations,
       elements.no_kanji,
       COALESCE((SELECT group_concat(restricted_kanji, :delimiter)
        FROM vocab_kana_restriction
        WHERE element_id = elements.element_id), '') AS restricted_kanji
FROM vocab_kana_element AS elements
WHERE elements.entry_id IN :entryIds
ORDER BY elements.entry_id, elements.priority IS NULL, elements.priority, elements.element_id;

getVocabSensesWithDetails:
WITH
    Senses AS (SELECT id, entry_id FROM vocab_sense WHERE entry_id IN :words),
    SenseIds AS (SELECT id FROM Senses),
    KanjiRestrictions AS (SELECT sense_id, GROUP_CONCAT(reading, :delimiter) AS kanji_restrictions
                          FROM vocab_sense_kanji_restriction
                          WHERE sense_id IN SenseIds
                          GROUP BY sense_id),
    KanaRestrictions AS (SELECT sense_id, GROUP_CONCAT(reading, :delimiter) AS kana_restrictions
                         FROM vocab_sense_kana_restriction
                         WHERE sense_id IN SenseIds
                         GROUP BY sense_id),
    UngroupedGlosses AS (SELECT sense_id, gloss_text
                         FROM vocab_sense_gloss
                         WHERE sense_id IN SenseIds
                         ORDER BY rowid),
    GroupedGlosses AS (SELECT sense_id, GROUP_CONCAT(gloss_text, :delimiter) AS glosses
                       FROM UngroupedGlosses
                       GROUP BY sense_id),
    UngroupedPos AS (SELECT sense_id, part_of_speech, explanation
                     FROM vocab_sense_part_of_speech
                              INNER JOIN vocab_entity ON part_of_speech = name
                     WHERE sense_id IN SenseIds
                     ORDER BY vocab_sense_part_of_speech.rowid),
    GroupedPos AS (SELECT sense_id, GROUP_CONCAT(explanation, :delimiter) AS explanations
                   FROM UngroupedPos
                   GROUP BY sense_id),
    Informations AS (SELECT sense_id, GROUP_CONCAT(information, :delimiter) AS info
                     FROM vocab_sense_information
                     WHERE sense_id IN SenseIds
                     GROUP BY sense_id)
SELECT Senses.entry_id,
       Senses.id,
       KanjiRestrictions.kanji_restrictions,
       KanaRestrictions.kana_restrictions,
       GroupedGlosses.glosses,
       GroupedPos.explanations,
       Informations.info
FROM Senses
         LEFT JOIN KanjiRestrictions ON Senses.id = KanjiRestrictions.sense_id
         LEFT JOIN KanaRestrictions ON Senses.id = KanaRestrictions.sense_id
         LEFT JOIN GroupedGlosses ON Senses.id = GroupedGlosses.sense_id
         LEFT JOIN GroupedPos ON Senses.id = GroupedPos.sense_id
         LEFT JOIN Informations ON Senses.id = Informations.sense_id;

getSentencesWithTextCount:
SELECT COUNT(*)
FROM sentence
WHERE sentence LIKE '%' || :text || '%';

getSentencesWithText:
SELECT sentence, translation, furigana
FROM sentence
WHERE sentence LIKE '%' || :text || '%'
ORDER BY score, tatoeba_id
LIMIT :limit OFFSET :offset;

getFuriganaForWord:
SELECT text, reading, furigana
FROM vocab_furigana
WHERE text IN :kanjiList AND reading IN :kanaList;
